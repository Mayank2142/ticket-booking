# Railway/Render managed PostgreSQL connection string.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cinebook?schema=public"
# One-time migration source only; do not configure this in normal production runtime.
SOURCE_DATABASE_URL="file:./dev.db"
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=10000
# Scaled local/API runtime. DB_POOL_MAX is per API worker.
API_WORKERS=4
API_MAX_IN_FLIGHT=2000
API_MAX_CONNECTIONS=20000
API_KEEP_ALIVE_TIMEOUT_MS=5000
API_HEADERS_TIMEOUT_MS=10000
API_REQUEST_TIMEOUT_MS=30000
API_MAX_REQUESTS_PER_SOCKET=1000
PUBLIC_CACHE_TTL_MS=5000
PUBLIC_CACHE_MAX_ENTRIES=250
STATIC_CACHE_MAX_ENTRIES=128
STATIC_CACHE_MAX_FILE_BYTES=5000000
# Production defaults to 1% access-log sampling; errors and slow requests always log.
ACCESS_LOG_SAMPLE_RATE=0.01
ACCESS_LOG_SLOW_MS=1000
# Production refuses defaults/short values. Generate independent random secrets of at least 32 bytes.
JWT_SECRET="change-me-in-production"
SEAT_HOLD_TTL_MINUTES=10
WAITLIST_OFFER_TTL_MINUTES=15
CRON_SECRET="change-me-in-production"
WORKER_INTERVAL_MS=30000
WORKER_BATCH_SIZE=25
JOB_RETRY_BASE_MS=5000
JOB_RETRY_MAX_MS=900000
JOB_STALE_AFTER_MS=300000
WORKER_RECOVER_RUNNING_ON_START=true

# Optional cross-instance real-time fan-out. The app falls back to local events
# and a 30-second browser refresh when Redis is unavailable.
REDIS_URL=

# optional — emails log to console if unset
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="tickets@example.com"
APP_URL="http://localhost:3000"
WEB_URL="http://localhost:5173"
ALLOWED_ORIGINS="http://localhost:5173"
READINESS_REQUIRE_SMTP=false
BUILD_SHA=

# Optional Firebase Authentication. Web config is public; never expose Admin credentials.
# Enable Google + Email/Password and authorise the website domain in Firebase Console.
FIREBASE_PROJECT_ID=cinebook-4cc4b
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=cinebook-4cc4b.firebaseapp.com
FIREBASE_APP_ID=1:14981435885:web:c57aab7944b3ff858257e4
FIREBASE_CLIENT_EMAIL=
# Paste the service-account private_key into the environment, not source control.
# Both real newlines and escaped \n sequences are supported.
FIREBASE_PRIVATE_KEY=

# HTTPS booking emails (Railway Trial blocks SMTP). Requires a verified sender domain.
# Configure both API and worker. Existing SMTP delivery remains supported.
RESEND_API_KEY=
EMAIL_FROM=
