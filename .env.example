# Railway/Render managed PostgreSQL connection string.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cinebook?schema=public"
# One-time migration source only; do not configure this in normal production runtime.
SOURCE_DATABASE_URL="file:./dev.db"
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=10000
JWT_SECRET="change-me-in-production"
SEAT_HOLD_TTL_MINUTES=10
WAITLIST_OFFER_TTL_MINUTES=15
CRON_SECRET="change-me-in-production"
WORKER_INTERVAL_MS=30000

# Optional cross-instance real-time fan-out. The app falls back to local events
# and a 30-second browser refresh when Redis is unavailable.
REDIS_URL=

# optional — emails log to console if unset
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="tickets@example.com"
APP_URL="http://localhost:3000"
WEB_URL="http://localhost:5173"
ALLOWED_ORIGINS="http://localhost:5173"
READINESS_REQUIRE_SMTP=false
BUILD_SHA=
