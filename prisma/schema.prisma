generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  ORGANISER
  CUSTOMER
}

enum EventType {
  MOVIE
  CONCERT
}

enum SeatStatus {
  AVAILABLE
  HELD
  BOOKED
  UNAVAILABLE
}

enum SeatType {
  STANDARD
  WHEELCHAIR
  COMPANION
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
}

enum WaitlistStatus {
  WAITING
  OFFERED
  FULFILLED
  EXPIRED
}

enum ShowStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  ARCHIVED
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(CUSTOMER)
  createdAt DateTime @default(now())
  reminderEmails Boolean @default(true)
  waitlistAlerts Boolean @default(true)
  emailVerifiedAt DateTime?
  emailVerificationTokenHash String? @unique
  emailVerificationExpiresAt DateTime?

  events    Show[]
  bookings  Booking[]
  waitlist  WaitlistEntry[]
  heldSeats ShowSeat[] @relation("HeldBy")
  favourites Favourite[]
  recentlyViewed RecentlyViewed[]
  auditLogs AuditLog[] @relation("AuditActor")
}

model City {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())
  archivedAt DateTime?
  venues    Venue[]
}

model Venue {
  id         String         @id @default(cuid())
  name       String
  city       String         @default("Delhi")
  address    String?
  auditorium String         @default("Main Auditorium")
  rows       Int
  cols       Int
  createdAt  DateTime       @default(now())
  archivedAt DateTime?
  cityId     String?
  cityRecord City?          @relation(fields: [cityId], references: [id])

  categories SeatCategory[]
  seats      Seat[]
  events     Show[]
  auditoriums Auditorium[]

  @@index([cityId, name])
}

model Auditorium {
  id        String   @id @default(cuid())
  venueId   String
  venue     Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  name      String
  rows      Int
  cols      Int
  createdAt DateTime @default(now())
  archivedAt DateTime?
  shows     Show[]

  @@unique([venueId, name])
}

model Content {
  id              String    @id @default(cuid())
  identityKey     String    @unique
  title           String
  type            EventType
  description     String?
  language        String    @default("Hindi")
  format          String    @default("2D")
  genre           String    @default("Entertainment")
  durationMinutes Int       @default(120)
  certificate     String?
  posterUrl       String?
  releaseDate     String?
  castNames       String    @default("")
  crewNames       String    @default("")
  trailerUrl      String?
  formats         String    @default("")
  performerNames  String    @default("")
  ageRule         String?
  entryRule       String?
  createdAt       DateTime  @default(now())

  shows      Show[]
  favourites Favourite[]
  recentlyViewed RecentlyViewed[]

  @@index([type, language, genre])
}

model RecentlyViewed {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  contentId String
  content   Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)
  viewedAt  DateTime @default(now())

  @@unique([userId, contentId])
  @@index([userId, viewedAt])
}

model Favourite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  contentId String
  content   Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, contentId])
  @@index([userId, createdAt])
}

model SeatCategory {
  id      String @id @default(cuid())
  venueId String
  venue   Venue  @relation(fields: [venueId], references: [id], onDelete: Cascade)
  name    String
  color   String @default("#6366f1")

  seats    Seat[]
  prices   CategoryPrice[]
  waitlist WaitlistEntry[]
}

model Seat {
  id         String       @id @default(cuid())
  venueId    String
  venue      Venue        @relation(fields: [venueId], references: [id], onDelete: Cascade)
  categoryId String
  category   SeatCategory @relation(fields: [categoryId], references: [id])
  row        Int
  col        Int
  label      String
  seatType   SeatType     @default(STANDARD)
  aisleAfter Boolean      @default(false)
  isBlocked  Boolean      @default(false)
  viewLabel  String?
  viewScore  Int?

  showSeats    ShowSeat[]
  bookingSeats BookingSeat[]

  @@unique([venueId, row, col])
}

model Show {
  id          String    @id @default(cuid())
  organiserId String
  organiser   User      @relation(fields: [organiserId], references: [id])
  venueId     String
  venue       Venue     @relation(fields: [venueId], references: [id])
  contentId   String?
  content     Content?  @relation(fields: [contentId], references: [id])
  auditoriumId String?
  auditorium Auditorium? @relation(fields: [auditoriumId], references: [id])
  status      ShowStatus @default(PUBLISHED)
  title       String
  type        EventType
  description String?
  date        String
  time        String
  createdAt   DateTime  @default(now())

  prices    CategoryPrice[]
  showSeats ShowSeat[]
  bookings  Booking[]
  waitlist  WaitlistEntry[]

  @@index([contentId, date, time])
  @@index([status, date, time])
  @@index([auditoriumId, date, time])
  @@map("Event")
}

model CategoryPrice {
  id         String       @id @default(cuid())
  eventId    String
  event      Show         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  categoryId String
  category   SeatCategory @relation(fields: [categoryId], references: [id])
  price      Float

  @@unique([eventId, categoryId])
}

model ShowSeat {
  id        String     @id @default(cuid())
  eventId   String
  event     Show       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  seatId    String
  seat      Seat       @relation(fields: [seatId], references: [id])
  status    SeatStatus @default(AVAILABLE)
  heldUntil DateTime?
  heldById  String?
  heldBy    User?      @relation("HeldBy", fields: [heldById], references: [id])
  version   Int        @default(0)
  unavailableReason String?

  @@unique([eventId, seatId])
}

model Booking {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id])
  eventId     String
  event       Show          @relation(fields: [eventId], references: [id])
  ref         String        @unique
  status      BookingStatus @default(CONFIRMED)
  totalAmount Float
  ticketEmailSentAt DateTime?
  ticketEmailAttempts Int       @default(0)
  ticketEmailLastError String?
  cancellationEmailSentAt DateTime?
  reminderEmailSentAt DateTime?
  createdAt   DateTime      @default(now())

  seats BookingSeat[]
}

model BookingSeat {
  id        String  @id @default(cuid())
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  seatId    String
  seat      Seat    @relation(fields: [seatId], references: [id])

  @@unique([bookingId, seatId])
}

model WaitlistEntry {
  id             String         @id @default(cuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id])
  eventId        String
  event          Show           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  categoryId     String
  category       SeatCategory   @relation(fields: [categoryId], references: [id])
  position       Int
  status         WaitlistStatus @default(WAITING)
  offerToken     String?        @unique
  offerExpiresAt DateTime?
  offeredSeatId  String?
  offerNotifiedAt DateTime?
  offerNotificationAttempts Int @default(0)
  offerNotificationLastError String?
  joinedEmailSentAt DateTime?
  expiredEmailSentAt DateTime?
  createdAt      DateTime       @default(now())

  @@unique([eventId, categoryId, userId])
  @@unique([eventId, categoryId, position])
  @@index([eventId, categoryId, status, position])
}

model MaintenanceRun {
  id          String    @id @default(cuid())
  status      String
  resultJson  String    @default("{}")
  error       String?
  startedAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([startedAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String?
  metadata   String   @default("{}")
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([entityType, entityId])
}

model AlertSubscription {
  id              String   @id @default(cuid())
  email           String   @unique
  active          Boolean  @default(true)
  confirmationSentAt DateTime?
  deliveryAttempts Int     @default(0)
  lastError       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([active, createdAt])
}

model BackgroundJob {
  id          String   @id @default(cuid())
  type        String
  payloadJson String   @default("{}")
  status      String   @default("PENDING")
  attempts    Int      @default(0)
  maxAttempts Int      @default(5)
  availableAt DateTime @default(now())
  startedAt   DateTime?
  completedAt DateTime?
  lastError   String?
  resultJson  String   @default("{}")
  dedupeKey   String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, availableAt])
  @@index([type, status])
}

model EmailPreview {
  id              String   @id @default(cuid())
  kind            String
  recipient       String
  subject         String
  textBody        String
  htmlBody        String
  relatedEntityId String?
  createdAt       DateTime @default(now())

  @@index([createdAt])
  @@index([kind, createdAt])
}
