{
  "name": "ticket-booking-system",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": "22.x"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "8.0.0"
    },
    "prisma": {
      "mysql2": "3.23.1"
    }
  },
  "scripts": {
    "dev": "node scripts/dev-local.mjs",
    "dev:api": "npm run dev --workspace @cinebook/api",
    "dev:web": "npm run dev --workspace @cinebook/web",
    "db:generate": "prisma generate && prisma generate --schema prisma/schema.test.prisma",
    "build": "npm run db:generate && npm run build:web && npm run typecheck",
    "build:web": "npm run build --workspace @cinebook/web",
    "start": "npm run start --workspace @cinebook/api",
    "start:scale": "tsx apps/api/src/cluster.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && npm run typecheck:web",
    "typecheck:web": "npm run typecheck --workspace @cinebook/web",
    "test": "node scripts/run-tests.mjs",
    "test:postgres": "node scripts/run-postgres-tests.mjs",
    "test:e2e": "playwright test",
    "test:load": "node scripts/load-test.mjs",
    "email:verify": "tsx scripts/verify-email.ts",
    "cron:cleanup": "tsx scripts/invoke-cleanup.ts",
    "worker:start": "tsx apps/worker/src/index.ts",
    "redis:up": "docker compose -f compose.redis.yml up -d",
    "redis:down": "docker compose -f compose.redis.yml down",
    "redis:diagnostics": "tsx scripts/check-redis.ts",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:deploy:sqlite": "prisma migrate deploy --config prisma.test.config.ts",
    "db:setup:sqlite": "npm run db:deploy:sqlite",
    "db:migrate:sqlite": "tsx scripts/migrate-sqlite-to-postgres.ts",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.9.1",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "^7.9.1",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^17.4.2",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^10.0.13",
    "pg": "8.16.3",
    "qrcode": "^1.5.4",
    "redis": "5.9.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^9.6.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.6",
    "eslint": "^9.39.3",
    "prisma": "^7.9.1",
    "tsx": "^4.23.12",
    "typescript-eslint": "^8.71.0",
    "typescript": "^5"
  }
}
